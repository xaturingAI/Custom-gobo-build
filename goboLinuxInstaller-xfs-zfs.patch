-		safeRun('umount ' + destMountPoint)
+		if fileSystem == 'ZFS' :
+			# Export the pool so it can be imported again on the installed box.
+			cmd = 'zfs set mountpoint=legacy rpool && zpool export rpool'
+		else :
+			cmd = 'umount ' + destMountPoint
+		safeRun(cmd)
 
 
