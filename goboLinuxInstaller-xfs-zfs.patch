@@ -1105,6 +1121,22 @@ def _RunInstallation():
 	cmd = 'GenFstab %s %s > %s/System/Settings/fstab'%(espParams, genFstabParams,destMountPoint)
 	safeRun(cmd, 'fstab generation', 0, logger)
 
+	if fileSystem == 'ZFS' :
+		# GenFstab guesses root's filesystem from the booted live device
+		# (auto), which is wrong for a ZFS root. Rewrite the root line so the
+		# installed system imports rpool at boot instead.
+		fstab_path = destMountPoint+'/System/Settings/fstab'
+		fstab_lines = safeFileReadLines(fstab_path, logger)
+		root_idx = None
+		for i, line in enumerate(fstab_lines) :
+			if line and line[0] != '#' and line.split() and line.split()[1] == '/' :
+				root_idx = i
+				break
+		zfs_root_line = 'rpool / zfs defaults 0 0'
+		if root_idx is not None :
+			fstab_lines[root_idx] = zfs_root_line
+			safeWriteToFile(fstab_path, "\n".join(fstab_lines)+"\n", logger)
+
 	lines = safeFileReadLines(destMountPoint+'/System/Settings/fstab', logger)
 	lines = [x for x in lines if x and x[0] != '#' and x.find('/Mount/') > -1]
 	mountList = [x.split()[1] for x in lines]
