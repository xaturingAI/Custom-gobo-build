# GoboLinux ZFS-root support for the custom SysVinit runtime
# Companion to goboLinuxInstaller-xfs-zfs.patch (installer ZFS pool/GRUB).
# Apply with: cd / && patch -p1 < gobo-zfs-sysvinit-support.patch
#
--- a/Programs/OpenZFS/2.4.4/lib/dracut/modules.d/90zfs/module-setup.sh
+++ b/Programs/OpenZFS/2.4.4/lib/dracut/modules.d/90zfs/module-setup.sh
@@ -1,4 +1,5 @@
 #!/usr/bin/env bash
+# gobo livefix 45: make 90zfs work on the SysVinit hierarchy
 # shellcheck disable=SC2154
 
 check() {
@@ -50,6 +51,24 @@
 		fi
 	fi
 
+	# GoboLinux boots with a custom SysVinit runtime: OpenZFS binaries live
+	# under /Programs/.../bin behind the /System/Index symlink farm, and dracut
+	# copies the resolved real file into the initramfs at its /Programs path - which
+	# is NOT on the initramfs PATH. Anchor the toolchain into /sbin so the classic
+	# import/mount hooks below can actually find it.
+	for _tool in zpool zfs mount.zfs zgenhostid; do
+		_real="$(command -v "${_tool}" | xargs -r readlink -f)"
+		if [ -n "${_real}" ] && [ -x "${_real}" ]; then
+			inst "${_real}" "/sbin/${_tool}" || {
+				dfatal "Failed to install ${_tool} into initramfs /sbin"
+				exit 1
+			}
+		else
+			dfatal "ZFS tool ${_tool} not found; cannot build a ZFS initramfs"
+			exit 1
+		fi
+	done
+
 	inst_hook cmdline 95 "${moddir}/parse-zfs.sh"
 	if [[ -n "${systemdutildir}" ]]; then
 		inst_script "${moddir}/zfs-generator.sh" "${systemdutildir}/system-generators/dracut-zfs-generator"
@@ -75,7 +94,7 @@
 		fi
 	fi
 
-	if dracut_module_included "systemd"; then
+	if dracut_module_included "systemd" && [ -f "${systemdsystemunitdir}/zfs-import.target" ]; then
 		inst_simple "${systemdsystemunitdir}/zfs-import.target"
 		systemctl -q --root "${initdir}" add-wants initrd.target zfs-import.target
 
